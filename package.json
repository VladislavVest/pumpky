{
  "name": "pumpky-tracker",
  "version": "1.0.0",
  "description": "Atmospheric pumpkin task tracker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.vladislavvest.pumpky",
    "productName": "Pumpky",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.js",
      "preload.js",
      "Sourses/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "Sourses/img/mainico.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "VladislavVest",
        "repo": "pumpky"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}